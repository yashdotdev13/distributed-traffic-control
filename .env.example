# Optional overrides for monitoring and dependency image versions.
# Defaults are set in docker-compose.yml if these are unset.
# Copy to .env and adjust if you need a different reviewed version.

# Image versions
REDIS_VERSION=7.4
JAEGER_VERSION=2.22.0
PROMETHEUS_VERSION=v3.13.4
GRAFANA_VERSION=13.2.4

# Gateway resource limits (applied independently to each gateway)
GATEWAY_CPUS=1.0
GATEWAY_MEMORY=512M

# Redis resource limits
REDIS_MEMORY=256M
